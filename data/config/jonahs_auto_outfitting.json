# Auto Outfitting settings, used when LunaLib isn't enabled (with LunaLib, change them in its settings menu instead).
# Read at startup and on every save load.
{
	"jao_enabled":true,
	"jao_roles":true,               # build each ship for its fleet role (skirmisher, flanker, line, anchor, carrier ...)
	"jao_civilianLogistics":true,   # civilian ships get campaign hullmods, no weapons, no vents or capacitors
	"jao_civilianSmods":false,      # with Build in s-mods ticked, civilian cruisers, capitals and salvage rigs build in fleet-wide hullmods (Treasure Hunt, surveying, sensors, burn)
	"jao_fleetBalance":true,        # complement the rest of the fleet (fighter roles, anti-shield / anti-armor)
	"jao_style":"Auto",            # Auto, Balanced, Anti-shield, Anti-armor, Hull killer
	"jao_allStyles":false,
	"jao_range":"Auto",            # Auto, Long, Close
	"jao_fightSeconds":90,

	"jao_specialWeapons":true,
	"jao_preferRare":false,
	"jao_cheatItems":false,        # use weapons and LPCs you can only get with cheats (no blueprint, no faction, no ship carries them)
	"jao_communityTiers":true,     # lean a little on the community's AI weapon ratings (Grievous69's tier lists) when the numbers are close
	"jao_rareBonus":0.15,         # +15% for the rarest weapon when preferRare is on
	"jao_keepPriority":true,       # doctrine priority weapons and fighters win when within 1% of the best choice
	"jao_buyGain":0.01,           # a market weapon must add 1% per 10,000 credits it costs (0 = prices ignored)
	"jao_pdFloor":1,
	"jao_allowDrawbacks":false,      # true: hullmods with any downside (supplies, range, speed ...) may be used
	"jao_safetyOverrides":"Frigates and destroyers",   # Never, Frigates and destroyers, When it scores best
	"jao_logistics":false,
	"jao_skipWeapons":"",          # weapon ids or patterns the Optimal fit never picks, e.g. "stardust_lightproton, SKR_*"

	# s-mods, used when the autofit box "Build in s-mods" is ticked (story points are permanent)
	"jao_smodCount":1,               # new s-mods per ship in one fit or one Optimize fleet
	"jao_smodFleetMax":2,            # story points one Optimize fleet spends in total, biggest ships first
	"jao_smodMinGain":0.02,
	"jao_smodWait":true,
	"jao_smodWaitMargin":0.1,
	"jao_smodWaitDays":30,
	"jao_smodReserve":3,             # story points never spent

	# fleet production order (Order weapons for fleet button on the refit screen)
	"jao_productionButton":true,
	"jao_productionBudget":0.5,
	# Random Assortment of Things: a Frontiers settlement with Ordnance Manufacturing takes what fits its budget first
	"jao_ratSettlement":true,

	"jao_debug":false,
}
